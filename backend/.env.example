# SQL database: PostgreSQL for production, SQLite is the local default.
MEMORY_DATABASE_URL=postgresql+psycopg://guibao:change-me@127.0.0.1:5432/guibao

# Redis current-session cache. Omit or leave empty for the local fallback.
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=86400
SESSION_KEEP=20

# Knowledge base priority
PRIORITY_STANDARD_BOOST=80

# Memory context budget
MEMORY_TOKEN_BUDGET=1500
MEMORY_CONTEXT_FACTS=10
MEMORY_MAX_ITEMS_PER_USER=500
MEMORY_IMPORT_JSON=1

# LLM structured memory distillation
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# Agent Function Calling
AGENT_FUNCTION_CALLING_ENABLED=1
AGENT_MAX_TOOL_TURNS=2
AGENT_LLM_TIMEOUT_SECONDS=20
AGENT_TOOL_RESULT_CHARS=8000
AGENT_LLM_MAX_TOKENS=1200

# Web search is disabled by default. Enabling this only makes it available;
# an API request must also set disable_web_search=false.
WEB_SEARCH_ENABLED=0

# Rule-based memory extraction is the default to avoid hidden LLM calls.
MEMORY_LLM_ENABLED=0
MEMORY_LLM_TIMEOUT_SECONDS=20
MEMORY_MAX_FACTS_PER_TURN=12

# Feedback CSV export. Keep this empty to disable the admin export endpoint.
FEEDBACK_ADMIN_TOKEN=

# Feedback dashboard login. Change the password before deploying publicly.
FEEDBACK_DASHBOARD_USERNAME=zwszff
FEEDBACK_DASHBOARD_PASSWORD=change-me
